# Modo demo: usa el backend simulado en el navegador (false = API Gateway real)
VITE_DEMO_MODE=true

# API Gateway (R14): todas las llamadas del SPA pasan por aquí
VITE_API_GATEWAY_URL=/api/v1

# Idioma por defecto (es | en) y zona horaria de fechas
VITE_DEFAULT_LOCALE=es
VITE_TIME_ZONE=America/Lima

# Términos y condiciones vigentes
VITE_TERMS_VERSION=1.0
VITE_TERMS_PUBLISHED_AT=2026-09-01

# Economía (hotspots del informe): comisión de LendUp y del proveedor de pagos
VITE_LENDUP_COMMISSION_RATE=0.1
VITE_PAYMENT_PROVIDER_FEE_RATE=0

# Evidencias (Cloudinary) y análisis asistido (Gemini)
VITE_MAX_UPLOAD_MB=2
VITE_EVIDENCE_ANALYSIS_TIMEOUT_MS=20000

# Recordatorios y mapas
VITE_REMINDER_LEAD_HOURS=24
VITE_GOOGLE_MAPS_API_KEY=
