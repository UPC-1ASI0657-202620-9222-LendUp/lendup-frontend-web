# Public browser configuration. Never place service-account JSON or private keys here.
# Every VITE_* variable is visible in the browser. Copy to .env.local and pick ONE profile.

# --- Profile 1: local lendup-e2e environment (gateway + Firebase Auth emulator) ---
# Start it from ../lendup-e2e: docker compose up -d --build
VITE_API_GATEWAY_URL=http://localhost:8090/api/v1
# Only honoured by `npm run dev` (import.meta.env.DEV); ignored in production builds.
VITE_FIREBASE_AUTH_EMULATOR_URL=http://localhost:9099
# The emulator accepts any api key / app id, but the project id must match
# FIREBASE_PROJECT_ID of the microservices (lendup-e2e uses lendup-desarrollo).
VITE_FIREBASE_API_KEY=emulador
VITE_FIREBASE_AUTH_DOMAIN=localhost
VITE_FIREBASE_PROJECT_ID=lendup-desarrollo
VITE_FIREBASE_APP_ID=local

# --- Profile 2: production (AWS) ---
# Replace the block above with the real values. Leave VITE_FIREBASE_AUTH_EMULATOR_URL unset.
# VITE_API_GATEWAY_URL=https://<gateway-aws-url>/api/v1   # pending: URL not yet provided by the AWS owner
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_STORAGE_BUCKET=

# --- Common ---
VITE_GOOGLE_MAPS_API_KEY=
VITE_DEFAULT_LOCALE=es
VITE_TIME_ZONE=America/Lima
