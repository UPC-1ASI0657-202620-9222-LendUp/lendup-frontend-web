# Public browser configuration. Never place service-account JSON or private keys here.
# Monolito modular para Préstamos, Evidencias, Incidencias y rutas heredadas.
VITE_RENDER_API_GATEWAY_URL=https://lendup-backend.onrender.com/api/v1
# Opcional: URL pública HTTPS del Spring Cloud Gateway de AWS (INCLUIR /api/v1).
# No usar http://100.48.16.62:8090 desde el navegador HTTPS.
# Al configurar esta variable, los seis contextos migrados se envían a AWS.
VITE_AWS_API_GATEWAY_URL=

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

VITE_GOOGLE_MAPS_API_KEY=
VITE_DEFAULT_LOCALE=es
VITE_TIME_ZONE=America/Lima
